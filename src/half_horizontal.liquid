<div class="layout layout--row layout--stretch-cross gap--medium">
  <div class="flex flex--col flex--center-y flex--left gap--xsmall w--52 shrink-0">
    <div><span class="value value--large value--tnums" data-ep="now">–</span> <span class="title title--small">öre</span></div>
    <span class="description" data-ep="cheaper-short"></span>
    <span class="description" data-ep="cheap-short"></span>
  </div>
  <div class="grow h--full" data-ep="chart" data-compact="true" data-max-slots="96"></div>
</div>
<script>
  (function () {
    const root = document.currentScript.previousElementSibling;
    const E = window.ELPRIS_CURRENT;
    document.addEventListener("DOMContentLoaded", function () { window.elprisFill(root, E); });
  })();
</script>
<div class="title_bar">
  <span class="title">Elpris {{ cf.area | default: "SE3" }}</span>
  <span class="instance">öre/kWh{% if vat_on %} inkl. moms{% endif %}</span>
</div>
