<div class="layout layout--row layout--stretch-cross gap--large">
  <div class="flex flex--col flex--between w--60 shrink-0">
    <div class="flex flex--col flex--left">
      <span class="title">Just nu</span>
      <div><span class="value value--xlarge value--tnums" data-ep="now">–</span> <span class="title">öre</span></div>
      <span class="label label--filled label--large" data-ep="level"></span>
    </div>
    <div class="item"><div class="content">
      <span class="label">Billigare</span>
      <span class="title" data-ep="cheaper">–</span>
    </div></div>
    <div class="item"><div class="content">
      <span class="label" data-ep="cheap-label">Billigaste fönster</span>
      <span class="title" data-ep="cheap">–</span>
    </div></div>
    <div class="item"><div class="content">
      <span class="label">Idag min / snitt / max</span>
      <span class="title" data-ep="day">–</span>
    </div></div>
  </div>
  <div class="flex flex--col grow">
    <div class="grow w--full h--min-72" data-ep="chart"></div>
    <span class="description description--large text--right">▼ nu · per kvart · svart billigast · randigt lågpris</span>
  </div>
</div>
<script>
  (function () {
    const root = document.currentScript.previousElementSibling;
    const E = window.ELPRIS_CURRENT;
    document.addEventListener("DOMContentLoaded", function () { window.elprisFill(root, E); });
  })();
</script>
<div class="title_bar">
  <span class="title">Elpris {{ cf.area | default: "SE3" }}</span>
  <span class="instance">öre/kWh{% if vat_on %} inkl. moms{% endif %}</span>
</div>
